<UserControl x:Class="CursorForge.Client.Views.MyCursorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:CursorForge.Client.Converters">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
    </UserControl.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <ui:TextBlock Text="My Uploaded Themes" FontTypography="Title" Margin="0,0,0,4"/>
            <ui:TextBlock Text="Manage your published cursor themes, review moderation status, and delete themes." 
                          Appearance="Secondary"/>
        </StackPanel>

        <!-- Status / Notice -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <ProgressBar IsIndeterminate="True" 
                         Height="4" 
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                         Margin="0,0,0,8"/>
            <ui:TextBlock Text="{Binding StatusMessage}" 
                          Appearance="Secondary" 
                          Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>

        <!-- List of Cursors -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cursors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <ui:SymbolIcon Grid.Column="0" Symbol="Cursor24" FontSize="28" 
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" FontSize="16" Margin="0,0,12,0"/>
                                        <!-- Status Badge -->
                                        <Border Background="#2000AAFF" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#FF66CCFF" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <!-- Stats -->
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Heart24" Margin="0,0,4,0" FontSize="14" Foreground="#FFFF6688"/>
                                        <TextBlock Text="{Binding LikeCount}" Margin="0,0,16,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                        <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,4,0" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{Binding DownloadCount}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <ui:Button Grid.Column="2" 
                                           Content="Delete" 
                                           Appearance="Secondary" 
                                           VerticalAlignment="Center" 
                                           Command="{Binding DataContext.DeleteCursorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           CommandParameter="{Binding}"/>
                            </Grid>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
