<UserControl x:Class="CursorForge.Client.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32">
        <!-- Main Content Area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                <!-- Header -->
                <ui:TextBlock Text="Account &amp; Security" FontTypography="Title" Margin="0,0,0,4"/>
                <ui:TextBlock Text="Manage your cloud profile, community sharing identity, and security keys." 
                              Appearance="Secondary" Margin="0,0,0,24"/>

                <!-- Banner Messages -->
                <ui:CardControl Margin="0,0,0,16" 
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                Background="#33FF4444" BorderBrush="#AAFF4444">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,8,0" Foreground="#FFFF6666"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFFCCCC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,16" 
                                Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                Background="#3322AA44" BorderBrush="#AA22AA44">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,8,0" Foreground="#FF66FF66"/>
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#FFCCFFCC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- State 1: Signed In Profile -->
                <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                    <ui:CardControl Margin="0,0,0,16">
                        <StackPanel Margin="8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="PersonCircle32" Margin="0,0,12,0" FontSize="36" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding CurrentUsername, StringFormat='@{0}'}" FontTypography="Subtitle"/>
                                    <ui:TextBlock Text="{Binding CurrentUserId, StringFormat='ID: {0}'}" Appearance="Tertiary" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <Separator Margin="0,0,0,16"/>

                            <ui:TextBlock Text="Security &amp; Encryption" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="Your session token is encrypted on this machine using Windows Data Protection API (DPAPI). Only your Windows user account can decrypt it." 
                                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <ui:Button Content="Sign Out" 
                                       Appearance="Secondary" 
                                       Command="{Binding SignOutCommand}" 
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ui:CardControl>
                </StackPanel>

                <!-- State 2: Signed Out / Auth Form -->
                <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVis}}">
                    <ui:CardControl Margin="0,0,0,16">
                        <StackPanel Margin="12">
                            <!-- Toggle Mode (Sign In vs Create Account) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <RadioButton Content="Sign In" 
                                             GroupName="AuthMode"
                                             IsChecked="{Binding IsSignInMode, Mode=TwoWay}"
                                             FontWeight="SemiBold"
                                             Margin="0,0,24,0"/>
                                <RadioButton Content="Create Account" 
                                             GroupName="AuthMode"
                                             IsChecked="{Binding IsRegisterMode, Mode=TwoWay}"
                                             FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Username Input -->
                            <ui:TextBlock Text="Username" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding UsernameInput, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="e.g. cursor_master" 
                                        Margin="0,0,0,12"/>

                            <!-- Password Input -->
                            <ui:TextBlock Text="Password" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                            <ui:PasswordBox x:Name="AuthPasswordBox"
                                            PasswordChanged="OnPasswordChanged" 
                                            PlaceholderText="Min 8 characters" 
                                            Margin="0,0,0,16"/>

                            <!-- Terms of Service (Registration only) -->
                            <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding TermsAccepted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="I accept the "/>
                                        <Hyperlink Command="{Binding OpenTermsModalCommand}">
                                            <Run Text="Terms of Service &amp; Privacy Policy"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <ui:TextBlock Text="No email required. A 20-character single-use Crockford recovery key will be generated for account recovery." 
                                              Appearance="Tertiary" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <!-- Sign In Button -->
                                <ui:Button Content="Sign In" 
                                           Appearance="Primary" 
                                           Command="{Binding SignInCommand}" 
                                           Visibility="{Binding IsRegisterMode, Converter={StaticResource InverseBoolToVis}}"
                                           Margin="0,0,12,0"/>

                                <!-- Register Button -->
                                <ui:Button Content="Create Account" 
                                           Appearance="Primary" 
                                           Command="{Binding SignUpCommand}" 
                                           Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,12,0"/>

                                <!-- Forgot Password Link -->
                                <ui:Button Content="Forgot Password?" 
                                           Appearance="Transparent" 
                                           Command="{Binding OpenResetModalCommand}"
                                           Visibility="{Binding IsRegisterMode, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>

                            <Separator Margin="0,20,0,16"/>

                            <!-- Quick Login with Default Demo Account -->
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="⚡ Quick Sign In as Default (momo)" 
                                           Appearance="Secondary" 
                                           Command="{Binding QuickLoginDemoCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- MODAL: One-Time Crockford Recovery Code Modal -->
        <Grid Background="#B0000000" Visibility="{Binding IsRecoveryModalOpen, Converter={StaticResource BoolToVis}}">
            <ui:CardControl MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Key24" FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                        <ui:TextBlock Text="Your Account Recovery Key" FontTypography="Subtitle" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ui:TextBlock Text="Save this key now! This is the ONLY way to recover your account if you forget your password. It will NEVER be shown again." 
                                  Foreground="#FFFF9966" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="#20000000" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <TextBlock Text="{Binding DisplayedRecoveryCode}" 
                                   FontFamily="Consolas, Courier New" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   TextAlignment="Center" 
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Copy Key" Appearance="Secondary" Command="{Binding CopyRecoveryCodeCommand}" Margin="0,0,8,0"/>
                        <ui:Button Content="I Have Saved It" Appearance="Primary" Command="{Binding DismissRecoveryModalCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl>
        </Grid>

        <!-- MODAL: Password Reset Modal -->
        <Grid Background="#B0000000" Visibility="{Binding IsResetModalOpen, Converter={StaticResource BoolToVis}}">
            <ui:CardControl MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <StackPanel Margin="16">
                    <ui:TextBlock Text="Reset Account Password" FontTypography="Subtitle" Margin="0,0,0,8"/>
                    <ui:TextBlock Text="Enter your username, 20-character recovery key, and your new password." 
                                  Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <ui:TextBlock Text="Username" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding ResetUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <ui:TextBlock Text="Recovery Key" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding ResetRecoveryCode, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX" Margin="0,0,0,10"/>

                    <ui:TextBlock Text="New Password (min 8 chars)" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                    <ui:PasswordBox x:Name="ResetPasswordBox" PasswordChanged="OnResetPasswordChanged" Margin="0,0,0,16"/>

                    <!-- Rotated Recovery Key Notification (if success) -->
                    <StackPanel Visibility="{Binding NewRotatedRecoveryCode, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,16">
                        <ui:TextBlock Text="Save your NEW rotated recovery key:" Foreground="#FF66FF66" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Border Background="#20000000" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <TextBlock Text="{Binding NewRotatedRecoveryCode}" FontFamily="Consolas" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                        <ui:Button Content="Copy New Key" Appearance="Secondary" Command="{Binding CopyRotatedRecoveryCodeCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:Button Content="Cancel" Appearance="Secondary" Command="{Binding CloseResetModalCommand}" Margin="0,0,8,0"/>
                        <ui:Button Content="Reset Password" Appearance="Primary" Command="{Binding SubmitResetCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl>
        </Grid>

        <!-- MODAL: Terms of Service & Privacy Policy Modal -->
        <Grid Background="#B0000000" Visibility="{Binding IsTermsModalOpen, Converter={StaticResource BoolToVis}}">
            <ui:CardControl MaxWidth="520" MaxHeight="550" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0" Text="CursorForge Terms &amp; Privacy Policy" FontTypography="Subtitle" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <ui:TextBlock Text="1. Privacy &amp; Data Collection" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="CursorForge does NOT collect your real email address or real name. Your account is tied strictly to your chosen username. We do not track personal browsing habits or sell any user data." 
                                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <ui:TextBlock Text="2. Single-Use Recovery Keys" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="Because no email is attached to your account, account recovery is handled exclusively by a 20-character cryptographic Crockford Base32 recovery key generated upon signup. We only store a salted SHA-256 hash of this key. If you lose your recovery key and password, your account cannot be recovered." 
                                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <ui:TextBlock Text="3. Local Security &amp; Windows DPAPI" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="When you log in on this machine, your authorization tokens are encrypted on disk using the Windows Data Protection API (DPAPI). Only your specific Windows user profile can decrypt these credentials." 
                                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <ui:TextBlock Text="4. Community Publishing Guidelines" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="When uploading cursor themes to the community catalog, you confirm that your artwork does not contain malicious code, copyright infringement, or harmful content. Uploaded public themes are shared freely with the CursorForge community." 
                                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ui:Button Grid.Row="2" Content="Got It" Appearance="Primary" HorizontalAlignment="Right" Command="{Binding CloseTermsModalCommand}"/>
                </Grid>
            </ui:CardControl>
        </Grid>
    </Grid>
</UserControl>
