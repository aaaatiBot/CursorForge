<UserControl x:Class="CursorForge.Client.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Search Controls -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <ui:TextBlock Text="Community Catalog" FontTypography="Title" Margin="0,0,0,4"/>
            <ui:TextBlock Text="Discover, preview, and download custom cursor schemes published by creators." 
                          Appearance="Secondary" Margin="0,0,0,16"/>

            <!-- Search and Filter Bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" 
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                            PlaceholderText="Search by title, style, or tag..." 
                            Icon="{ui:SymbolIcon Symbol=Search24}" 
                            Margin="0,0,12,0">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding LoadInitialPageCommand}"/>
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <ui:Button Grid.Column="1" 
                           Content="Search" 
                           Appearance="Primary" 
                           Command="{Binding LoadInitialPageCommand}" 
                           Margin="0,0,12,0"/>

                <!-- Sort Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Newest" 
                               Appearance="Secondary" 
                               Command="{Binding SelectSortCommand}" 
                               CommandParameter="Newest" 
                               Margin="0,0,6,0"/>
                    <ui:Button Content="Most Liked" 
                               Appearance="Secondary" 
                               Command="{Binding SelectSortCommand}" 
                               CommandParameter="MostLiked" 
                               Margin="0,0,6,0"/>
                    <ui:Button Content="Most Downloaded" 
                               Appearance="Secondary" 
                               Command="{Binding SelectSortCommand}" 
                               CommandParameter="MostDownloaded"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Status & Loading indicator -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <ProgressBar IsIndeterminate="True" 
                         Height="4"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                         Margin="0,0,0,8"/>
            <ui:TextBlock Text="{Binding StatusMessage}" 
                          Appearance="Secondary" 
                          Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"
                          Margin="4,0,0,0"/>
        </StackPanel>

        <!-- Main Items Catalog Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Width="340" Margin="0,0,16,16" Padding="16">
                                <StackPanel>
                                    <!-- Title & Author -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:SymbolIcon Symbol="Cursor24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" FontSize="15"/>
                                            <ui:TextBlock Text="{Binding OwnerUsername, StringFormat='by @{0}'}" Appearance="Tertiary" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               TextWrapping="Wrap" 
                                               MaxHeight="48" 
                                               TextTrimming="CharacterEllipsis" 
                                               Margin="0,0,0,12"/>

                                    <!-- Tags ItemsControl -->
                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,0,0,16">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,0,0,12"/>

                                    <!-- Card Actions: Likes & Download -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Like Button -->
                                        <ui:Button Grid.Column="0" 
                                                   Appearance="Transparent" 
                                                   Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                   CommandParameter="{Binding}"
                                                   Padding="6,4"
                                                   Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Heart24" Margin="0,0,6,0" Foreground="#FFFF6688"/>
                                                <TextBlock Text="{Binding LikeCount}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <!-- Download Count -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding DownloadCount}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Download Action Button -->
                                        <ui:Button Grid.Column="2" 
                                                   Content="Download" 
                                                   Appearance="Primary" 
                                                   HorizontalAlignment="Right" 
                                                   Command="{Binding DataContext.DownloadCursorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                   CommandParameter="{Binding}"/>
                                    </Grid>
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Load More Button -->
                <ui:Button Content="Load More Cursors" 
                           Appearance="Secondary" 
                           HorizontalAlignment="Center" 
                           Command="{Binding LoadMoreCommand}" 
                           Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" 
                           Margin="0,16,0,32"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
