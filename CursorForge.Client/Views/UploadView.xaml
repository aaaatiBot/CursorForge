<UserControl x:Class="CursorForge.Client.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:CursorForge.Client.Converters"
             AllowDrop="True"
             DragOver="OnDropZoneDragOver"
             DragLeave="OnDropZoneDragLeave"
             Drop="OnDropZoneDrop">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
    </UserControl.Resources>
    <Grid Margin="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                <!-- Header -->
                <ui:TextBlock Text="Creator Studio" FontTypography="Title" Margin="0,0,0,4"/>
                <ui:TextBlock Text="Design, preview, and publish custom cursor schemes with automatic multi-DPI conversion." 
                              Appearance="Secondary" Margin="0,0,0,24"/>

                <!-- Status Banners -->
                <ui:CardControl Margin="0,0,0,16" 
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                Background="#33FF4444" BorderBrush="#AAFF4444">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,8,0" Foreground="#FFFF6666"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFFCCCC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,16" 
                                Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}"
                                Background="#3322AA44" BorderBrush="#AA22AA44">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,8,0" Foreground="#FF66FF66"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#FFCCFFCC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Step 1: Metadata Card -->
                <ui:CardControl Margin="0,0,0,16">
                    <StackPanel Margin="12">
                        <ui:TextBlock Text="1. Theme Information" FontTypography="Subtitle" Margin="0,0,0,16"/>

                        <ui:TextBlock Text="Theme Name" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="e.g. Momo Cat Cursor" 
                                    Margin="0,0,0,12"/>

                        <ui:TextBlock Text="Description" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Describe your cursor design, aesthetics, and recommended background styles..." 
                                    AcceptsReturn="True" 
                                    Height="54" 
                                    Margin="0,0,0,12"/>

                        <ui:TextBlock Text="Tags (comma-separated, max 5)" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding TagsInput, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Cat, Cute, Pink, Minimal, Pixel" 
                                    Margin="0,0,4,0"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Step 2: Artwork & Hotspot Card -->
                <ui:CardControl Margin="0,0,0,16">
                    <StackPanel Margin="12">
                        <ui:TextBlock Text="2. Cursor Artwork &amp; Hotspot" FontTypography="Subtitle" Margin="0,0,0,16"/>

                        <!-- Drag and Drop Dropzone (Shown when no file selected) -->
                        <Border x:Name="DropZone"
                                Visibility="{Binding HasSelectedFile, Converter={StaticResource InverseBoolToVis}}"
                                AllowDrop="True"
                                CornerRadius="8"
                                BorderThickness="2"
                                BorderBrush="#55FFFFFF"
                                Background="#10FFFFFF"
                                Padding="28,24"
                                Margin="0,0,0,16"
                                DragOver="OnDropZoneDragOver"
                                DragLeave="OnDropZoneDragLeave"
                                Drop="OnDropZoneDrop">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="42" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <ui:TextBlock Text="Drag and drop your cursor PNG here" FontTypography="Subtitle" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <ui:TextBlock Text="— or —" Appearance="Tertiary" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <ui:Button Content="Browse Files..." 
                                           Appearance="Primary" 
                                           HorizontalAlignment="Center"
                                           Command="{Binding SelectPngFileCommand}" 
                                           Margin="0,0,0,12"/>
                                <ui:TextBlock Text="Requirements: PNG with transparency • Up to 128x128 px • File size under 100 KB" 
                                              Appearance="Tertiary" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Selected File & Interactive Preview (Shown when file is loaded) -->
                        <StackPanel Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVis}}">
                            <!-- File Info Bar -->
                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Image24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedFileName}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SelectedFileInfoText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" 
                                               Content="Change Image" 
                                               Appearance="Secondary" 
                                               Command="{Binding SelectPngFileCommand}" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Interactive Artwork Preview with Click-To-Hotspot -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Visual Preview Box -->
                                <Border Grid.Column="0" 
                                        Width="150" Height="150" 
                                        Background="#15171C" 
                                        BorderBrush="#33FFFFFF" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Margin="0,0,20,0"
                                        ClipToBounds="True">
                                    <Grid Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Cursor Image -->
                                        <Image Source="{Binding SelectedPngPath}" 
                                               Width="{Binding ImageWidth}" 
                                               Height="{Binding ImageHeight}" 
                                               Stretch="None" 
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                        <!-- Hotspot Overlay Canvas (Clickable) -->
                                        <Canvas Width="{Binding ImageWidth}" 
                                                Height="{Binding ImageHeight}" 
                                                Background="Transparent"
                                                Cursor="Cross"
                                                MouseLeftButtonDown="OnPreviewCanvasMouseLeftButtonDown">
                                            <!-- Hotspot Marker Circle -->
                                            <Ellipse Width="11" Height="11" 
                                                     Margin="-5,-5,0,0" 
                                                     Stroke="#FFFF3366" 
                                                     StrokeThickness="2" 
                                                     Fill="#88FF3366" 
                                                     Canvas.Left="{Binding HotspotX}" 
                                                     Canvas.Top="{Binding HotspotY}"/>
                                            <!-- Center point -->
                                            <Ellipse Width="3" Height="3" 
                                                     Margin="-1,-1,0,0" 
                                                     Fill="#FFFFFFFF" 
                                                     Canvas.Left="{Binding HotspotX}" 
                                                     Canvas.Top="{Binding HotspotY}"/>
                                        </Canvas>
                                    </Grid>
                                </Border>

                                <!-- Hotspot Controls & Presets -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Active Click Hotspot" FontTypography="BodyStrong" Margin="0,0,0,2"/>
                                    <ui:TextBlock Text="Click anywhere on the preview to position the exact click point, or set coordinates below." 
                                                  Appearance="Secondary" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <ui:TextBlock Text="Hotspot X (px)" Appearance="Secondary" FontSize="11" Margin="0,0,0,2"/>
                                            <ui:TextBox Text="{Binding HotspotX, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <ui:TextBlock Text="Hotspot Y (px)" Appearance="Secondary" FontSize="11" Margin="0,0,0,2"/>
                                            <ui:TextBox Text="{Binding HotspotY, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Presets -->
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="Presets: " VerticalAlignment="Center" Appearance="Tertiary" FontSize="11" Margin="0,0,6,0"/>
                                        <ui:Button Content="Top-Left (0, 0)" Appearance="Transparent" Command="{Binding SetHotspotCommand}" CommandParameter="0,0" Margin="0,0,4,0"/>
                                        <ui:Button Content="Arrow Tip (8, 8)" Appearance="Transparent" Command="{Binding SetHotspotCommand}" CommandParameter="8,8" Margin="0,0,4,0"/>
                                        <ui:Button Content="Center (16, 16)" Appearance="Transparent" Command="{Binding SetHotspotCommand}" CommandParameter="16,16"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl>

                <!-- Step 3: Publish Button -->
                <StackPanel Margin="0,8,0,32">
                    <ProgressBar IsIndeterminate="True" 
                                 Height="4" 
                                 Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}" 
                                 Margin="0,0,0,12"/>

                    <ui:Button Content="Publish Theme to Community &amp; Library" 
                               Appearance="Primary" 
                               HorizontalAlignment="Left" 
                               Command="{Binding PublishCommand}" 
                               Padding="24,10"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
