<UserControl x:Class="CursorForge.Client.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <!-- Header -->
                <ui:TextBlock Text="Creator Studio" FontTypography="Title" Margin="0,0,0,4"/>
                <ui:TextBlock Text="Design and publish custom cursor schemes with automatic multi-DPI conversion." 
                              Appearance="Secondary" Margin="0,0,0,24"/>

                <!-- Status Banners -->
                <ui:CardControl Margin="0,0,0,16" 
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                Background="#33FF4444" BorderBrush="#AAFF4444">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,8,0" Foreground="#FFFF6666"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFFCCCC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,16" 
                                Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}"
                                Background="#3322AA44" BorderBrush="#AA22AA44">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,8,0" Foreground="#FF66FF66"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#FFCCFFCC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Step 1: Metadata Card -->
                <ui:CardControl Margin="0,0,0,16">
                    <StackPanel Margin="12">
                        <ui:TextBlock Text="1. Theme Information" FontTypography="Subtitle" Margin="0,0,0,16"/>

                        <ui:TextBlock Text="Theme Name" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="e.g. Neon Horizon" 
                                    Margin="0,0,0,12"/>

                        <ui:TextBlock Text="Description" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Describe your cursor design, aesthetics, and recommended backgrounds..." 
                                    AcceptsReturn="True" 
                                    Height="60" 
                                    Margin="0,0,0,12"/>

                        <ui:TextBlock Text="Tags (comma-separated, max 5)" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding TagsInput, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Neon, Cyber, Dark, Minimal" 
                                    Margin="0,0,0,4"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Step 2: Artwork & Hotspot Card -->
                <ui:CardControl Margin="0,0,0,16">
                    <StackPanel Margin="12">
                        <ui:TextBlock Text="2. Cursor Artwork &amp; Hotspot" FontTypography="Subtitle" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:Button Content="Choose PNG File..." 
                                       Appearance="Secondary" 
                                       Command="{Binding SelectPngFileCommand}" 
                                       Margin="0,0,12,0"/>
                            <ui:TextBlock Text="{Binding SelectedPngPath, Converter={StaticResource NullToVisibilityConverter}}" 
                                          VerticalAlignment="Center" 
                                          Appearance="Secondary"/>
                        </StackPanel>

                        <ui:TextBlock Text="Requirements: Valid PNG with transparency, dimensions up to 128x128 px, file size under 100 KB." 
                                      Appearance="Tertiary" FontSize="11" Margin="0,0,0,16"/>

                        <Separator Margin="0,0,0,16"/>

                        <!-- Hotspot Selector -->
                        <ui:TextBlock Text="Active Click Hotspot Coordinates" FontTypography="BodyStrong" Margin="0,0,0,4"/>
                        <ui:TextBlock Text="Defines the exact pixel where the mouse registers clicks (e.g. tip of arrow or finger of pointing hand)." 
                                      Appearance="Secondary" FontSize="12" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <ui:TextBlock Text="Hotspot X (px)" Appearance="Secondary" FontSize="11" Margin="0,0,0,2"/>
                                <ui:TextBox Text="{Binding HotspotX, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <ui:TextBlock Text="Hotspot Y (px)" Appearance="Secondary" FontSize="11" Margin="0,0,0,2"/>
                                <ui:TextBox Text="{Binding HotspotY, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Presets -->
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="Presets: " VerticalAlignment="Center" Appearance="Tertiary" Margin="0,0,8,0"/>
                            <ui:Button Content="Top-Left (0, 0)" Appearance="Transparent" Command="{Binding SetHotspotCommand}" CommandParameter="0,0" Margin="0,0,4,0"/>
                            <ui:Button Content="Center (16, 16)" Appearance="Transparent" Command="{Binding SetHotspotCommand}" CommandParameter="16,16" Margin="0,0,4,0"/>
                            <ui:Button Content="Tip (4, 4)" Appearance="Transparent" Command="{Binding SetHotspotCommand}" CommandParameter="4,4"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl>

                <!-- Step 3: Publish Button -->
                <StackPanel Margin="0,8,0,32">
                    <ProgressBar IsIndeterminate="True" 
                                 Height="4" 
                                 Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}" 
                                 Margin="0,0,0,12"/>

                    <ui:Button Content="Publish Theme to Community" 
                               Appearance="Primary" 
                               HorizontalAlignment="Left" 
                               Command="{Binding PublishCommand}" 
                               Padding="20,10"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
