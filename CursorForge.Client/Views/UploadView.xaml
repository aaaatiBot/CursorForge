<UserControl x:Class="CursorForge.Client.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Top">
            <ui:TextBlock Text="Upload Theme" FontTypography="Title" Margin="0,0,0,8"/>
            <ui:TextBlock Text="Publish a new cursor theme to the CursorForge community." Appearance="Secondary" Margin="0,0,0,16"/>
            <ui:CardControl Header="Session-Based Uploader" Margin="0,8,0,8">
                <ui:TextBlock Text="Server-allocated upload sessions ensure complete validation before publishing." Appearance="Secondary"/>
            </ui:CardControl>
        </StackPanel>
    </Grid>
</UserControl>

